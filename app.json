{
  "expo": {
    "name": "Planeo",
    "slug": "planeo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "planeo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.felipeapps.planeo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F6A98",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.felipeapps.planeo"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B5C8A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "@react-native-google-signin/google-signin",
      [
        "expo-location",
        {
          "locationWhenInUseUsageDescription": "Planeo usa tu ubicación solo cuando pulsas avisar en la pantalla de emergencia, para incluirla en el mensaje a tu contacto de confianza."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Planeo usa el micrófono solo mientras grabas una nota de voz para enviarla en un chat."
        }
      ],
      "expo-asset",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
