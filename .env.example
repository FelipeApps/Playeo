# Copia este archivo como .env.local y ajusta la IP.
# El móvil con Expo Go no entiende "localhost": pon la IP de tu PC en la wifi
# (la ves con `ipconfig`, "Dirección IPv4").
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.36:54321
# Clave anónima que imprime `npx supabase status`. La de local es pública y fija.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Inicio de sesión con Google (los ID de cliente son públicos; el secreto va en supabase/.env).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
